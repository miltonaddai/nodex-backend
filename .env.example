# Environment
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5175

# Demo mode — accepts any email/password (default on when Supabase is not configured)
DEMO_MODE=true

# Supabase (Auth + User Data)
# Leave blank or set DEMO_MODE=true to skip Supabase auth during development
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (Cache/Queue)
# Local: redis://localhost:6379
# Upstash (TLS required — note the rediss:// scheme):
#   rediss://default:<UPSTASH_PASSWORD>@<endpoint>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ClickHouse (Blockchain Analytics)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=nodex
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_REQUEST_TIMEOUT_MS=60000

# Helius (Solana wallet tracking & infra)
HELIUS_API_KEY=your-helius-api-key

# Birdeye (Token data)
BIRDEYE_API_KEY=your-birdeye-api-key

# Alchemy (Robinhood Chain infra)
ALCHEMY_API_KEY=your-alchemy-api-key
ALCHEMY_SOLANA_URL=https://solana-mainnet.g.alchemy.com/v2/your-key
ALCHEMY_ROBINHOOD_URL=https://robinhood-chain.g.alchemy.com/v2/your-key

# Stripe (Subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# Frontend URL (Stripe redirect + billing portal return). Must match your Vite dev port.
FRONTEND_URL=http://localhost:5175

# Solana alpha worker (run: yarn worker)
PROVIDER_REQUEST_TIMEOUT_MS=30000
WORKER_PIPELINE_TIMEOUT_MINUTES=110
WORKER_ENABLED=true
SYNC_CHAINS=solana,robinhood,bsc
TOKEN_SYNC_INTERVAL_MINUTES=120
WALLET_SYNC_INTERVAL_MINUTES=60
TOKEN_FETCH_LIMIT=50
TOKEN_MIN_LIQUIDITY=10000
TOKEN_MIN_VOLUME=5000
TOKEN_MIN_MARKET_CAP=10000
TOKEN_MIN_HOLDERS=20
ALPHA_MAX_TOKEN_AGE_DAYS=30
ALPHA_MAX_MARKET_CAP=20000000
ALPHA_TOKEN_PAGE_SIZE=50
ALPHA_TRANSACTION_PAGE_SIZE=100
ALPHA_BACKFILL_PAGES_PER_TOKEN=3
ALPHA_TOKENS_PER_RUN=10
ALPHA_MIN_DISTINCT_TOKENS=1
ALPHA_MIN_SMART_SCORE=50
ALPHA_MIN_PERIOD_PROFIT_USD=100
ALPHA_MIN_PERIOD_TRADES=5
ALPHA_TOP_TRADER_TOKENS=10
ALPHA_TOP_TRADER_TOKENS_30D=30
ALPHA_TOP_TRADERS_PER_TOKEN=10
ALPHA_TOP_TRADERS_24H_REFRESH_HOURS=24
ALPHA_TOP_TRADERS_7D_REFRESH_HOURS=72
ALPHA_TOP_TRADERS_30D_REFRESH_HOURS=168
# 0 = refresh market health only inside the pipeline. Any timer shorter than ClickHouse Cloud's
# idle timeout keeps the service awake (and billing) 24/7.
DEXSCREENER_REFRESH_INTERVAL_MINUTES=0
# Defaults to twice the health refresh cadence when unset.
# TOKEN_MARKET_HEALTH_MAX_AGE_MINUTES=
ALPHA_MIN_QUALIFIED_BUYERS=2
ALPHA_FRESH_WALLET_DAYS=7
ALPHA_MAX_FRESH_BUYER_SHARE=0.5
ALPHA_MIN_WALLET_NET_WORTH_USD=1000
# Legacy aggregate-worker settings retained for rollback compatibility.
WALLET_BIRDEYE_CANDIDATES=50
WALLET_PNL_ENRICH_LIMIT=12
WALLET_HELIUS_ENRICH_LIMIT=25
WALLET_MIN_TRADES=5
WALLET_MIN_VOLUME_USD=1000
WALLET_MIN_BALANCE_USD=500
WALLET_MIN_WIN_RATE=40
WALLET_MAX_PROFIT_VOLUME_RATIO=5
WALLET_SEED_ADDRESSES=
SOL_USD_PRICE_FALLBACK=150

# Mirror of backend SUBSCRIPTIONS_ENABLED. Keep the two in sync.
SUBSCRIPTIONS_ENABLED=false

# Robinhood Chain token holder counts (Birdeye has none for this chain).
BLOCKSCOUT_API_KEY=
